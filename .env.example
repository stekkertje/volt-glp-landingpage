# Hostinger runtime. Gebruik lokaal development zonder NODE_ENV=production.
NODE_ENV=production
# Hostinger installeert zo ook de buildtoolchain onder NODE_ENV=production.
NPM_CONFIG_INCLUDE=dev
# Laat build en runtime direct stoppen wanneer PostgreSQL ontbreekt.
REQUIRE_DATABASE=1
# Gebruik op Hostinger + Neon de directe/unpooled URL. De runtime pint
# search_path=public bij het verbinden; Neons transaction-pooler weigert die
# startupoptie.
DATABASE_URL=
# Directe/unpooled PostgreSQL-URL voor deploymigraties en advisory locking.
# Neem een expliciete niet-lege gebruiker en wachtwoord op in de URL; de
# migrator gebruikt nooit USER of ~/.pgpass als credentialfallback.
# Zet de database in het URL-pad (/databasenaam), niet in ?database=... .
# Standaardschema wordt expliciet op public gepind. Eventuele
# `options=-c search_path=...` moet in DATABASE_URL en deze migratie-URL
# dezelfde veilige waarde hebben.
# Laat PGHOST/PGPORT/PGDATABASE/PGOPTIONS en andere PG*-connectievariabelen
# leeg voor de migrator; alle verbindingsinstellingen horen in deze URL.
# Bij Neon: dezelfde branch/database als DATABASE_URL; een andere rol mag wel.
# Wachten op gewone PostgreSQL-locks is per migratiesessie begrensd op 15 sec;
# de uitvoeringstijd van een actief migratiestatement zelf blijft onbeperkt.
# Voeg daarom geen statement_timeout, query_timeout of lock_timeout toe aan de
# URL of options; de migrator beheert uitsluitend zijn eigen lock_timeout.
MIGRATION_DATABASE_URL=
# Alternatieve standaardnaam van sommige database-integraties:
# DATABASE_URL_UNPOOLED=
# Voorkeur: apart, stabiel bestelgeheim van minimaal 32 tekens. Bij een
# persistente database gebruikt de app anders BETTER_AUTH_SECRET via een
# domeingescheiden sleutelafleiding; DATABASE_URL wordt nooit de actuele sleutel.
ORDER_ACCESS_TOKEN_SECRET=
# Optioneel apart HMAC-geheim voor adresbewijzen; anders wordt veilig
# teruggevallen op ORDER_ACCESS_TOKEN_SECRET of BETTER_AUTH_SECRET.
ADDRESS_VALIDATION_TOKEN_SECRET=
# Stabiel authgeheim van minimaal 32 tekens; tevens veilige fallback wanneer
# ORDER_ACCESS_TOKEN_SECRET niet apart is ingesteld.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://afslank-injecties.nl
# Tijdelijk tijdens sleutelrotatie: kommagescheiden oude waarden. Verwijder pas
# nadat alle herstelcodes die ermee zijn versleuteld (maximaal 72 uur) verlopen.
ORDER_ACCESS_TOKEN_PREVIOUS_SECRETS=
ADMIN_EMAILS=
# Kies exact één wachtwoordbron. Gebruik op Hostinger ADMIN_PASSWORD_BASE64 om
# tekens zoals %, # en & zonder interpretatie door de transportlaag te bewaren.
ADMIN_PASSWORD=
ADMIN_PASSWORD_BASE64=
ADMIN_SESSION_SECRET=

# Klantaccounts gebruiken e-mail/wachtwoord via Better Auth. Checkout blijft
# altijd om een actueel bezorgadres vragen, ook wanneer de klant is ingelogd.
VITE_AUTH_ENABLED=true
# Google/X is op productie opt-in. Zonder een eigen OAuth-client blijven alleen
# e-mail/wachtwoord en de afzonderlijke wachtwoord-admin zichtbaar.
VITE_OAUTH_ENABLED=false
# Alleen verplicht wanneer VITE_OAUTH_ENABLED=true. De issuer heeft een veilige
# standaard; client-id en client-secret horen uitsluitend in Hostinger secrets.
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
# GROK_AUTH_ISSUER=

# Hostinger-mailbox voor contact-, account- en bestelmail. Gebruik bij voorkeur
# de expliciete SMTP-namen; MAILBOX_* blijft alleen als lokale fallback bestaan.
# Laat de productieruntime direct stoppen als SMTP ontbreekt of onvolledig is.
REQUIRE_MAIL=1
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=info@afslank-injecties.nl
MAIL_FROM_NAME=VOLT
MAIL_OWNER_ADDRESS=info@afslank-injecties.nl

# Server-only integraties. Deze waarden mogen nooit met VITE_ beginnen.
REQUIRE_ADDRESS_VALIDATION=1
APICHECK_API_KEY=
GOOGLE_ADDRESS_VALIDATION_API_KEY=
# Ruwe MyParcel API-key; de server verstuurt deze uitsluitend als base64 in
# `Authorization: Basic ...`. Vul hier dus niet zelf een base64-waarde in.
MYPARCEL_API_KEY=
# Alleen instellen wanneer later een ondertekende MyParcel-webhook wordt aangezet.
MYPARCEL_WEBHOOK_SECRET=

# Tijdelijke testdeployment: zet beide op 1. VITE_NO_INDEX voegt een
# <meta name="robots"> toe en beide variabelen activeren ook de globale
# X-Robots-Tag-responseheader. Verwijder/zet uit vóór een publieke lancering.
VITE_NO_INDEX=1
NO_INDEX=1
VITE_PUBLIC_HOSTNAME=afslank-injecties.nl
# Pin op Hostinger de publieke HTTPS-origin voor mutaties en HSTS. Forwarded
# host/proto zijn daarbij nooit de autoriteit; alleen een enkel geldig
# X-Real-IP wordt voor bezoekersgebonden rate limits gebruikt.
TRUST_HOSTINGER_PROXY=1
